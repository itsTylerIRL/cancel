[Unit]
Description=THE CANCEL IS COMING leaderboard
After=network.target

[Service]
User=cancel
Group=cancel
EnvironmentFile=/etc/cancel-api.env
ExecStart=/usr/bin/python3 /opt/cancel-api/server.py
Restart=always
RestartSec=3
# small and boxed in: it shares the machine with other things
MemoryMax=150M
CPUQuota=50%
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cancel-api

[Install]
WantedBy=multi-user.target
